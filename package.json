{
  "name": "kinaesthetic-ai-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright smoke tests for the Kinaesthetic AI pitch site (/play, /pitch, /metrics, /admin, /privacy).",
  "scripts": {
    "verify:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Run-Local-CI.ps1",
    "test:e2e": "playwright test",
    "test:e2e:camera": "playwright test tests-e2e/play-camera.spec.ts",
    "test:e2e:layout": "playwright test tests-e2e/play-layout.spec.ts",
    "test:e2e:evidence": "playwright test tests-e2e/evidence-export.spec.ts tests-e2e/public-fallback.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "acorn": "^8.16.0"
  }
}
