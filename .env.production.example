HOST=0.0.0.0
PORT=8502
GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash

# Optional only when you terminate TLS inside Python yourself.
# Most hosts (Render/Railway/Cloud Run/Vercel proxy) provide HTTPS before the app,
# so leave these empty there.
SSL_CERT_FILE=
SSL_KEY_FILE=

# Optional hosted beta storage.
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVENTS_TABLE=kinaesthetic_events
