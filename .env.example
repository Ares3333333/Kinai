# Kinaesthetic AI · environment example
# Copy this file to ".env" and fill in only what you need.
# Do not commit a real API key.

# --- Primary cloud coach for online demo -------------------------------------
# Keep cloud keys only on the backend. Never expose them in browser JS.
GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.1-8b-instant

# --- Backup provider ----------------------------------------------------------
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash

# --- Optional OpenAI-compatible fallback for local experiments ----------------
# Leave these empty for the normal Gemini setup.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# --- Site server: write-token + CORS + consent --------------------------------
# Production: set KAI_WRITE_TOKEN to a strong random string and add the public
# origin(s) from which /play, /tester, /admin will run.
# Dev: set KAI_WRITE_AUTH=off to disable token + consent checks for tests.
# KAI_WRITE_TOKEN=
# KAI_WRITE_AUTH=on
# KAI_ALLOWED_ORIGINS=https://kinaestheticai.com,https://www.kinaestheticai.com

# --- Optional hosted storage (Supabase) ---------------------------------------
# Local JSONL is always the source of truth. Supabase mirror is opt-in and
# never touches raw video / audio. Failed events go to
# data/hosted_storage_failures.jsonl for offline replay.
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<paste-only-on-backend>
# SUPABASE_EVENTS_TABLE=kinaesthetic_events
# SUPABASE_TIMEOUT_MS=1500

# --- Optional HTTPS for site_server -------------------------------------------
# SSL_CERT_FILE=/path/to/fullchain.pem
# SSL_KEY_FILE=/path/to/privkey.pem

# Privacy note:
# Browser CV must send only derived signals to the backend, never raw video.
